<?xml version="1.0" encoding="UTF-8"?>
<!-- Realme GT Neo 2 (bitra) on lineage-24.0 (Android 17).
     device/hardware/kernel/common-vendor have lineage-24.0 branches; bitra-specific vendor, camera,
     dolby and RealmeAddons only exist on 23.2, so those are pinned there (may need re-extraction / fixes). -->
<manifest>
    <remote name="common" fetch="https://github.com/SM8250-Common" revision="lineage-24.0" />
    <remote name="ax" fetch="https://github.com/AxionAOSP-devices" revision="lineage-23.2" />
    <remote name="bijoy" fetch="https://gitlab.com/bijoyv9" revision="lineage-24.0" />

    <!-- Device -->
    <project path="device/realme/bitra" name="android_device_realme_bitra" remote="common" />
    <project path="device/realme/sm8250-common" name="android_device_realme_sm8250-common" remote="common" />

    <!-- Hardware -->
    <project path="hardware/oplus" name="android_hardware_oplus" remote="common" />
    <project path="hardware/dolby" name="android_hardware_dolby" remote="common" revision="lineage-23.2" />

    <!-- Kernel -->
    <project path="kernel/realme/sm8250" name="android_kernel_realme_sm8250" remote="common" clone-depth="1" />

    <!-- Packages -->
    <project path="packages/apps/RealmeAddons" name="android_packages_apps_RealmeAddons" remote="common" revision="lineage-23.2" />

    <!-- Vendor -->
    <project path="vendor/realme/bitra" name="proprietary_vendor_realme_bitra" remote="ax" revision="lineage-23.2" />
    <project path="vendor/realme/sm8250-common" name="proprietary_vendor_realme_sm8250-common" remote="bijoy" />
    <project path="vendor/oplus/camera" name="proprietary_vendor_oplus_camera" remote="bijoy" revision="lineage-23.2" />
</manifest>
