# Droidian (+ debug.config pstore): option list from Droidian common_fragments (branch 4.19-android), https://github.com/droidian-devices/common_fragments/blob/4.19-android/{droidian,debug}.config
# Converted: "=n" written as "# ... is not set". Only for a Droidian/Halium kernel build, NOT for the Lineage ROM kernel.
# CONFIG_ANDROID_PARANOID_NETWORK is not set
CONFIG_USER_NS=y
# CONFIG_ANDROID_BINDERFS is not set
CONFIG_SW_SYNC_USER=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_VETH=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,anbox-binder,anbox-hwbinder,anbox-vndbinder"
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_RMNET_BAM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_BT_HCIVHCI=y
CONFIG_BT_HIDP=y
CONFIG_BT_RFCOMM=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_SECURITY_YAMA=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_RAM_ANNOTATION_APPEND=y

# bitra: Oplus vibrator init does `write /sys/class/leds/vibrator/trigger transient` (odm vibrator-default.rc);
# without ledtrig-transient the write fails and the vibrator HAL cannot drive the motor.
CONFIG_LEDS_TRIGGER_TRANSIENT=y
