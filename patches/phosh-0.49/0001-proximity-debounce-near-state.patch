+/*
+ * The screen is blanked/unblanked based on the published near state. The display needs ~0.2-0.4 s
+ * to apply a power state change and a "far" arriving before the previous "near" has settled makes
+ * the power requests pile up (the screen then flickers on/off by itself). Like Android's
+ * DisplayPowerController we only act on a state that stayed stable for PROXIMITY_DEBOUNCE_MS.
+ */
+#define PROXIMITY_DEBOUNCE_MS 250
+
+static gboolean
+notify_near_state (PhoshProximity *self)
+{
+  self->timeout_id = 0;
+
+  /* A short near->far (or far->near) flicker leaves the published state unchanged: do nothing */
+  if (self->notified_near == self->near)
+    return G_SOURCE_REMOVE;
+
+  self->notified_near = self->near;
+  g_debug ("Proximity near published: %d", self->near);
+  g_object_notify_by_pspec (G_OBJECT (self), props[PROP_NEAR]);
+
+  return G_SOURCE_REMOVE;
+}
+
